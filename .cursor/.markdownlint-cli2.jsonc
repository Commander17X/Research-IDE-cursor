{
  // Lint configuration for the Research IDE documentation.
  // Long prose lines and inline HTML are intentional in these write-ups.
  "config": {
    "default": true,
    "MD013": false, // line-length: research prose uses long lines
    "MD033": false, // inline HTML: README embeds <img> tags
    "MD041": false  // first line need not be a top-level heading
  },
  // All documentation lives at the repository root; do not recurse into
  // .cursor/node_modules or other tooling directories.
  "globs": ["../*.md"],
  "ignores": ["**/node_modules/**"]
}
